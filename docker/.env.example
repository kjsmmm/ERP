# ERP 系统环境变量配置模板
# 复制此文件为 .env 并修改配置

# =============================================
# MySQL 配置
# =============================================
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_DATABASE=erp
MYSQL_PORT=3306

# =============================================
# Redis 配置
# =============================================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

# =============================================
# Adminer 配置
# =============================================
ADMINER_PORT=8080

# =============================================
# 应用配置
# =============================================
# 服务端口
SERVER_PORT=8080

# JWT 密钥（生产环境请修改为32字节以上的复杂密钥）
JWT_SECRET=CHANGE_ME_JWT_SECRET_32_BYTES_OR_MORE
JWT_ACCESS_TOKEN_EXPIRE=15
JWT_REFRESH_TOKEN_EXPIRE=10080

# 日志级别
LOG_LEVEL=DEBUG
